#!/bin/busybox sh
# Mamuthka Recovery – init
/bin/busybox --install -s /bin
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
# A kernel az /sbin/poweroff-ot hívja (pl. hővédelmi orderly_poweroff).
for c in poweroff reboot halt; do [ -e /sbin/$c ] || ln -s /bin/busybox /sbin/$c; done

mount -t proc -o nodev,noexec,nosuid proc /proc
mount -t sysfs -o nodev,noexec,nosuid sysfs /sys
mount -t devtmpfs -o mode=0755,nosuid dev /dev
mkdir -p /dev/pts /config /tmp /run /sysroot /mnt/sd /mnt/new
mount -t devpts devpts /dev/pts
mount -t configfs configfs /config 2>/dev/null
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run
hostname mamuthka-recovery
ip link set lo up

. /etc/mamuthka/recovery.conf
. /lib/mamuthka/usbnet.sh
. /lib/mamuthka/watchdog.sh
. /lib/mamuthka/diag.sh

exec >>/tmp/recovery.log 2>&1
echo "Mamuthka Recovery – $(uname -r)"
cat /proc/cmdline
kmark "recovery init indul ($(uname -r))"

# A napló a kernel naplójába is megy, így egy összeomlás/újraindulás után a
# következő indításkor a pstore-ban / /proc/last_kmsg-ben is látszik.
(tail -n +1 -f /tmp/recovery.log | while IFS= read -r l; do
	echo "mamuthka-recovery: $l" > /dev/kmsg
done) 2>/dev/null &

start_watchdogs

# Az előző indítás összeomlásának/újraindulásának nyomai.
collect_prev_boot
ls -la "$DIAG_DIR"
cat "$DIAG_DIR/osszegzes.txt"

# Csak a vészüzenetek menjenek a konzolra. (A panel parancsmódú: pánikkor már
# semmi nem visz át új képkockát, ezért a pánik szövege NEM látszik a kijelzőn;
# a következő induláskor a pstore/last_kmsg-ből olvassuk ki.)
dmesg -n 1
# Részletes DECON-napló a kernelnaplóba (hibernáció, időtúllépések) a következő
# indításkor kiolvasható nyomokhoz.
echo 6 > /sys/module/decon/parameters/decon_log_level 2>/dev/null
kmark "képernyő"

# Az előző újraindulás oka a képernyőn (lefotózható, ha a recovery megint újraindulna).
# (a rui a "\n" jelsorozatot sortörésként értelmezi)
rui status "Indítás…" "USB: telnet $USB_NET_IP\n\n$(awk '{printf "%s\\n", $0}' "$DIAG_DIR/osszegzes.txt")"

# A kimentett nyomok a telepített rendszer /var/log/mamuthka mappájába is
# bekerülnek (újraindulás után is megmaradnak, a rendszerből is olvashatók).
dev=""
for u in /sys/class/block/*/uevent; do
	if grep -qix "PARTNAME=$ROOTFS_PARTNAME" "$u"; then
		dev="/dev/$(sed -n 's/^DEVNAME=//p' "$u")"; break
	fi
done
if [ -n "$dev" ] && mount -t ext4 "$dev" /sysroot 2>/dev/null; then
	if [ -d /sysroot/var/log ]; then
		d="$(persist_prev_boot /sysroot/var/log/mamuthka)" && echo "Előző indítás nyomai mentve: $d"
	fi
	umount /sysroot
fi

kmark "USB-hálózat"
setup_usb_network
# A jelszó nélküli root-telnet CSAK az USB-kábelen legyen elérhető. A -b
# önmagában nem elég: a Linux a helyi címre bármely interfészen érkező csomagot
# elfogadja (weak host), így a Wi-Fi-hálózatból egy 172.16.42.1-re mutató
# útvonallal a telnet elérhető lenne. Ezért a más interfészről (Wi-Fi, modem)
# az USB-alhálózatra érkező csomagokat a házirend-útválasztás eldobja
# (prohibit); az USB-n és a helyben keletkezett forgalom változatlan.
# (Tesztelve veth-párokkal, busybox ip-vel: hibak.txt 57.)
usb_only() {
	net="${USB_NET_IP%.*}.0/24"
	ip route add prohibit "$net" table 99 &&
	ip rule add pref 50 iif "${IFACE:-usb0}" lookup local &&
	ip rule add pref 51 iif lo lookup local &&
	ip rule add pref 52 iif lo lookup main &&
	ip rule add pref 60 lookup 99 &&
	ip rule add pref 100 lookup local &&
	ip rule del pref 0 && return 0
	# Ha bármi nem sikerült, a szabályok visszaállnak.
	for p in 50 51 52 60 100; do ip rule del pref $p 2>/dev/null; done
	ip rule add pref 0 lookup local 2>/dev/null
	return 1
}
if ! usb_only; then
	# Tartalék: a telnet fut (USB-s hibakereséshez), de a Wi-Fi bekapcsolása
	# előtt a recovery leállítja (mamuthka-recovery: wifi_guard).
	echo "FIGYELEM: az USB-elszigetelés nem állítható be; Wi-Fi esetén a telnet leáll"
	touch /tmp/.telnet_unsafe
fi
# A recovery-ben a hibakereső shell elérhető USB-kábelen.
telnetd -b "$USB_NET_IP:23" -l /bin/sh
kmark "telnetd fut"
# Összeomlás után az ok maradjon olvashatóan a képernyőn egy ideig.
if prev_boot_crashed; then sleep 20; elif [ -s "$DIAG_DIR/proc_auto_comment" ]; then sleep 6; fi

kmark "menü"
while :; do
	/usr/bin/mamuthka-recovery
	echo "A recovery menü kilépett ($?), újraindítom"
	sleep 1
done
