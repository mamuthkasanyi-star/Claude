#!/bin/sh
# busybox udhcpc: cím, útvonal és DNS beállítása
# shellcheck disable=SC2154  # a változókat az udhcpc adja át
case "$1" in
	deconfig) ip addr flush dev "$interface" ;;
	bound|renew)
		ip addr flush dev "$interface"
		ip addr add "$ip/${mask:-24}" dev "$interface"
		ip route del default 2>/dev/null
		for r in $router; do ip route add default via "$r" dev "$interface"; break; done
		: > /etc/resolv.conf
		for d in $dns; do echo "nameserver $d" >> /etc/resolv.conf; done
		;;
esac
exit 0
