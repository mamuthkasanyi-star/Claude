-	psy_do_property(battery->pdata->wireless_charger_name, set,
-		POWER_SUPPLY_PROP_CAPACITY, value);
+	/* Mamuthka: az A51-nek nincs vezeték nélküli töltője
+	 * (wireless_charger_name == NULL); a feltétel nélküli hívás 10 s-onként
+	 * „Fail to set psy ((null))” hibát írt a kernelnaplóba. */
