# Mamuthka linux kiegészítések a postmarketOS A51 kernelkonfigurációhoz
# (config-base). A build-kernel.sh fűzi hozzá, majd "olddefconfig"-ot futtat.

CONFIG_LOCALVERSION="-mamuthka"
# CONFIG_LOCALVERSION_AUTO is not set
# (A DEVTMPFS_MOUNT initramfs-es bootnál hatástalan: az init maga csatolja.)

# Az S-Boot nem adja át a boot.img cmdline-ját, ezért itt adjuk meg.
# A kernel ezt a bootloader paraméterei ELÉ teszi (azok felülírhatják,
# pl. console=ram). A 4.14-es kernel cgroup v2-je hiányos, ezért systemd
# legacy (v1) cgroup módban fut.
# audit=0: a CONFIG_AUDIT be van fordítva, de nincs auditd → „kauditd hold
# queue overflow” és minden eseményt a kernelnaplóba önt (hibak.txt 56.).
# A bootloader a végére fűzi a loglevel=4-et (felülírja a miénket), ezért a
# konzol-naplószintet az initramfs és a sysctl állítja (kernel.printk).
CONFIG_CMDLINE="console=tty0 quiet splash loglevel=3 audit=0 vt.global_cursor_default=0 consoleblank=0 loop.max_part=7 systemd.unified_cgroup_hierarchy=0 SYSTEMD_CGROUP_ENABLE_LEGACY_FORCE=1"
CONFIG_CMDLINE_EXTEND=y

# systemd követelmények (systemd 255, Ubuntu 24.04)
CONFIG_FHANDLE=y
CONFIG_AUTOFS4_FS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_BLK_CGROUP=y

# Flatpak / bubblewrap
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y

# zram swap
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y

# Wi-Fi firmware helye (lásd device.conf FIRMWARE_DIR)
CONFIG_SCSC_CORE_FW_LOCATION="/lib/firmware/samsung-a51/mx140"

# A Samsung kernelben a hci_sock_create() ki van ürítve: a Bluetooth socket
# megnyitása összeomlást okoz. Javító patch nélkül kikapcsolva marad.
# CONFIG_BT is not set

# Hibakeresés bootloop ellen (UART és microSD nélkül):
# - A Samsung debug-snapshot (DEBUG_SNAPSHOT_*) beállításait a config-base
#   bekapcsolt értékein hagyjuk. NEM kapcsoljuk ki a PANIC_REBOOT-ot: a
#   DEBUG_SNAPSHOT_WATCHDOG_RESET függ tőle, és az kapuzza a
#   s3c2410wdt_set_emergency_reset() DEFINÍCIÓJÁT, amit stock Samsung-driverek
#   (pmucal, exynos-reboot, itmon, sec_debug) feltétel nélkül hívnak. Bármelyik
#   kikapcsolása "undefined reference" linkhibát ad (run 15/16, 745c4ed/14dbf06).
#   A pánik-üzenet láthatóvá tételét a pstore/ramoops post-mortem naplóval
#   oldjuk meg (külön lépés), nem a debug-snapshot kikapcsolásával.
# - PANIC_ON_OOPS: egy kernel-Oops se maradjon „csendes” folyamat-kilövés,
#   hanem látható pánik legyen (a recovery/initramfs init-je PID 1, egy Oops
#   ott különben is „Attempted to kill init” pánikba fut). Ez generikus
#   kernelopció, nem érinti a Samsung debug-snapshot szimbólumokat.
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_ON_OOPS_VALUE=1
CONFIG_PANIC_TIMEOUT=20

# Kijelző-hibernáció ki: a pmOS framebuffer-hack mellett a DECON minden rui
# indításkor (FBIOBLANK → needs_pan 200 ms ablak) teljes hibernáció be/ki ciklust
# járt (ULPS, tápdomén le/fel), miközben a vsync-szál állapot-ellenőrzés nélkül
# ír DECON regisztereket → ITMON-pánik kockázata. Recovery/UI-hoz nem kell.
# CONFIG_EXYNOS_HIBERNATION is not set

# USB gadget: a Samsung-féle configfs (USB_CONFIGFS_UEVENT) a linkelt funkciót a
# gi->linked_func listára teszi, amit csak az Android init tölt át
# (/sys/class/android_usb/android0/functions) → "failed to start g1: -22", és egy
# újabb unlink/link kernel-Oopsot okoz (S-Boot cmdline: oops=panic → reboot).
# Kikapcsolva + 0006 patch (az Ubuntu Touch A51-porttól, valódi készüléken igazolt).
# CONFIG_USB_CONFIGFS_UEVENT is not set
# CONFIG_USB_CONFIGFS_F_SS_MON_GADGET is not set
# CONFIG_USB_F_SS_MON_GADGET is not set
# CONFIG_USB_RNDIS_MULTIPACKET is not set

# Hiányzó firmware esetén ne várjon 60 mp-et a userspace-helperre (indulási
# percek); a systemd is ezt ajánlja. A régi hotplug-helper se fusson.
# CONFIG_FW_LOADER_USER_HELPER_FALLBACK is not set
CONFIG_UEVENT_HELPER_PATH=""
