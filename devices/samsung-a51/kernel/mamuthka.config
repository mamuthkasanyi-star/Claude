# Mamuthka linux kiegészítések a postmarketOS A51 kernelkonfigurációhoz
# (config-base). A build-kernel.sh fűzi hozzá, majd "olddefconfig"-ot futtat.

CONFIG_LOCALVERSION="-mamuthka"
# CONFIG_LOCALVERSION_AUTO is not set
# (A DEVTMPFS_MOUNT initramfs-es bootnál hatástalan: az init maga csatolja.)

# Az S-Boot nem adja át a boot.img cmdline-ját, ezért itt adjuk meg.
# A kernel ezt a bootloader paraméterei ELÉ teszi (azok felülírhatják,
# pl. console=ram). A 4.14-es kernel cgroup v2-je hiányos, ezért systemd
# legacy (v1) cgroup módban fut.
CONFIG_CMDLINE="console=tty0 quiet splash loglevel=3 vt.global_cursor_default=0 consoleblank=0 loop.max_part=7 systemd.unified_cgroup_hierarchy=0 SYSTEMD_CGROUP_ENABLE_LEGACY_FORCE=1"
CONFIG_CMDLINE_EXTEND=y

# systemd követelmények (systemd 255, Ubuntu 24.04)
CONFIG_FHANDLE=y
CONFIG_AUTOFS4_FS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_BLK_CGROUP=y

# Flatpak / bubblewrap
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y

# zram swap
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y

# Wi-Fi firmware helye (lásd device.conf FIRMWARE_DIR)
CONFIG_SCSC_CORE_FW_LOCATION="/lib/firmware/samsung-a51/mx140"

# A Samsung kernelben a hci_sock_create() ki van ürítve: a Bluetooth socket
# megnyitása összeomlást okoz. Javító patch nélkül kikapcsolva marad.
# CONFIG_BT is not set

# Hibakeresés bootloop ellen (UART és microSD nélkül):
# - A Samsung debug-snapshot pánik után AZONNAL újraindít (ramdump céljára),
#   így a pánik szövege sosem látszik, és a PANIC_TIMEOUT hatástalan. Kikapcsolva:
#   a kernel a pánikot kiírja a képernyőre (console=tty0), 20 mp-ig vár (a pánikkor élesített 30 mp-es hw watchdogon belül),
#   csak azután indít újra. A pstore/ramoops (log_pstore, 2 MiB) és a
#   /proc/last_kmsg a következő indításkor is visszaadja a naplót.
# - WATCHDOG_RESET: pánik közben 5 mp-es hardveres watchdogot indítana (a
#   30 mp helyett 5 mp-en belül reset) – ugyanezért kikapcsolva.
# - PANIC_ON_OOPS: egy kernel-Oops se maradjon „csendes” folyamat-kilövés,
#   hanem látható pánik legyen (a recovery/initramfs init-je PID 1, egy Oops
#   ott különben is „Attempted to kill init” pánikba fut).
# CONFIG_DEBUG_SNAPSHOT_PANIC_REBOOT is not set
# CONFIG_DEBUG_SNAPSHOT_WATCHDOG_RESET is not set
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_ON_OOPS_VALUE=1
CONFIG_PANIC_TIMEOUT=20
