+/***********************************************************************
+ * Mamuthka: RandR 1.2 crtc/output layer.
+ *
+ * One fake crtc and one output ("DSI-1") describe the fixed panel mode.
+ * The screen may be resized between the panel size and its transpose;
+ * rotation is implemented by the shadow layer (shadowUpdateRotatePacked),
+ * so the hardware mode is never changed.  Only plain rotations and
+ * identity transforms are accepted.
+ ***********************************************************************/
+
+static Bool
+fbdevRotIsSideways(Rotation rot)
+{
+    return (rot & (RR_Rotate_90 | RR_Rotate_270)) != 0;
+}
+
+static const char *
+fbdevRotName(Rotation rot)
+{
+    switch (rot & 0xf) {
+    case RR_Rotate_90:	return "left";
+    case RR_Rotate_180:	return "inverted";
+    case RR_Rotate_270:	return "right";
+    default:		return "normal";
+    }
+}
+
+/* (Re)attach the shadow update for rotation rot and repaint everything. */
+static Bool
+fbdevShadowSetRotation(ScrnInfoPtr pScrn, Rotation rot)
+{
+    FBDevPtr fPtr = FBDEVPTR(pScrn);
+    ScreenPtr pScreen = pScrn->pScreen;
+    PixmapPtr pPix;
+    RegionRec reg;
+    BoxRec box;
+
+    fPtr->rrRot = rot;
+
+    /* before CreateScreenResources: FBDevCreateScreenResources uses rrRot */
+    if (!fPtr->resourcesReady || !pScreen)
+	return TRUE;
+
+    pPix = pScreen->GetScreenPixmap(pScreen);
+    if (!pPix)
+	return FALSE;
+
+    if (fPtr->shadowActive) {
+	shadowRemove(pScreen, pPix);
+	fPtr->shadowActive = FALSE;
+    }
+    if (!shadowAdd(pScreen, pPix,
+		   rot == RR_Rotate_0 ? fbdevUpdatePacked : fbdevUpdateRotatePacked,
+		   FBDevWindowLinear, (int) rot, NULL))
+	return FALSE;
+    fPtr->shadowActive = TRUE;
+
+    box.x1 = 0;
+    box.y1 = 0;
+    box.x2 = pPix->drawable.width;
+    box.y2 = pPix->drawable.height;
+    RegionInit(&reg, &box, 1);
+    DamageDamageRegion(&pPix->drawable, &reg);
+    RegionUninit(&reg);
+    return TRUE;
+}
+
+static Bool
+fbdevCrtcResize(ScrnInfoPtr pScrn, int width, int height)
+{
+    FBDevPtr fPtr = FBDEVPTR(pScrn);
+    ScreenPtr pScreen = pScrn->pScreen;
+    PixmapPtr pPix;
+    int cpp = (pScrn->bitsPerPixel + 7) / 8;
+    int rw, rh;
+
+    if (width == pScrn->virtualX && height == pScrn->virtualY)
+	return TRUE;
+
+    /* the shadow buffer holds exactly one panel worth of pixels */
+    if ((long) width * height > (long) fPtr->hwWidth * fPtr->hwHeight) {
+	xf86DrvMsg(pScrn->scrnIndex, X_WARNING,
+		   "RandR: screen %dx%d larger than the %dx%d shadow, refused\n",
+		   width, height, fPtr->hwWidth, fPtr->hwHeight);
+	return FALSE;
+    }
+
+    if (!pScreen || !fPtr->resourcesReady)
+	return FALSE;
+    pPix = pScreen->GetScreenPixmap(pScreen);
+    if (!pPix)
+	return FALSE;
+
+    /* stop scanning out while the size does not match the rotation */
+    rw = fbdevRotIsSideways(fPtr->rrRot) ? fPtr->hwHeight : fPtr->hwWidth;
+    rh = fbdevRotIsSideways(fPtr->rrRot) ? fPtr->hwWidth : fPtr->hwHeight;
+    if ((width != rw || height != rh) && fPtr->shadowActive) {
+	shadowRemove(pScreen, pPix);
+	fPtr->shadowActive = FALSE;
+    }
+
+    if (!pScreen->ModifyPixmapHeader(pPix, width, height, -1, -1,
+				     width * cpp, NULL))
+	return FALSE;
+
+    pScrn->virtualX = width;
+    pScrn->virtualY = height;
+    pScrn->displayWidth = width;
+
+    /* size matches the rotation again (e.g. a failed change was reverted) */
+    if (width == rw && height == rh && !fPtr->shadowActive)
+	fbdevShadowSetRotation(pScrn, fPtr->rrRot);
+
+    xf86DrvMsg(pScrn->scrnIndex, X_INFO, "RandR: screen size %dx%d\n",
+	       width, height);
+    return TRUE;
+}
