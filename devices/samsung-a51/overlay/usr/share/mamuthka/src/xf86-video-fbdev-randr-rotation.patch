+static Bool
+fbdevCrtcSetModeMajor(xf86CrtcPtr crtc, DisplayModePtr mode,
+		      Rotation rotation, int x, int y)
+{
+    ScrnInfoPtr pScrn = crtc->scrn;
+    FBDevPtr fPtr = FBDEVPTR(pScrn);
+    Rotation rot = rotation & 0xf;
+    Rotation old = fPtr->rrRot;
+    int w, h;
+
+    if (rotation & ~0xf) {
+	xf86DrvMsg(pScrn->scrnIndex, X_WARNING, "RandR: reflection not supported\n");
+	return FALSE;
+    }
+    if (rot != RR_Rotate_0 && rot != RR_Rotate_90 &&
+	rot != RR_Rotate_180 && rot != RR_Rotate_270)
+	return FALSE;
+    if (mode->HDisplay != fPtr->hwWidth || mode->VDisplay != fPtr->hwHeight ||
+	x != 0 || y != 0) {
+	xf86DrvMsg(pScrn->scrnIndex, X_WARNING,
+		   "RandR: only %dx%d+0+0 is possible (asked %dx%d+%d+%d)\n",
+		   fPtr->hwWidth, fPtr->hwHeight,
+		   mode->HDisplay, mode->VDisplay, x, y);
+	return FALSE;
+    }
+    if (crtc->transformPresent &&
+	!pixman_transform_is_identity(&crtc->transform.transform)) {
+	xf86DrvMsg(pScrn->scrnIndex, X_WARNING,
+		   "RandR: only identity transforms are supported\n");
+	return FALSE;
+    }
+
+    w = fbdevRotIsSideways(rot) ? fPtr->hwHeight : fPtr->hwWidth;
+    h = fbdevRotIsSideways(rot) ? fPtr->hwWidth : fPtr->hwHeight;
+    if (pScrn->virtualX != w || pScrn->virtualY != h) {
+	xf86DrvMsg(pScrn->scrnIndex, X_WARNING,
+		   "RandR: screen %dx%d does not match rotated mode %dx%d\n",
+		   pScrn->virtualX, pScrn->virtualY, w, h);
+	return FALSE;
+    }
+
+    if (!fbdevShadowSetRotation(pScrn, rot)) {
+	xf86DrvMsg(pScrn->scrnIndex, X_ERROR, "RandR: shadow setup failed\n");
+	return FALSE;
+    }
+    if (rot != old)
+	xf86DrvMsg(pScrn->scrnIndex, X_INFO, "RandR: rotation %s\n",
+		   fbdevRotName(rot));
+    return TRUE;
+}
