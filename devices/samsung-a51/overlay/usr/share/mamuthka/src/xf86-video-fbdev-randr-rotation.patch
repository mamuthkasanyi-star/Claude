 static Bool
+FBDevRandRSetConfig(ScrnInfoPtr pScrn, xorgRRConfig *config)
+{
+    FBDevPtr fPtr = FBDEVPTR(pScrn);
+    ScreenPtr pScreen = xf86ScrnToScreen(pScrn);
+    PixmapPtr pPixmap;
+    int rot = config->rotation & (RR_Rotate_0 | RR_Rotate_90 |
+                                  RR_Rotate_180 | RR_Rotate_270);
+    int w = fPtr->hwWidth, h = fPtr->hwHeight;
+    int cpp = (pScrn->bitsPerPixel + 7) / 8;
+
+    if (!pScreen || !fPtr->shadow)
+        return FALSE;
+    switch (rot) {
+    case RR_Rotate_0:
+    case RR_Rotate_180:
+        break;
+    case RR_Rotate_90:
+    case RR_Rotate_270:
+        w = fPtr->hwHeight;
+        h = fPtr->hwWidth;
+        break;
+    default:
+        return FALSE;
+    }
+    pPixmap = pScreen->GetScreenPixmap(pScreen);
+    if (!pPixmap)
+        return FALSE;
+    /* Same shadow buffer (w*h is unchanged), new geometry. */
+    if (!pScreen->ModifyPixmapHeader(pPixmap, w, h, -1, -1, w * cpp, NULL))
+        return FALSE;
+    pScrn->displayWidth = w;
+    shadowRemove(pScreen, pPixmap);
+    if (!shadowAdd(pScreen, pPixmap,
+                   rot == RR_Rotate_0 ? fbdevUpdatePacked : fbdevUpdateRotatePacked,
+                   FBDevWindowLinear, rot == RR_Rotate_0 ? 0 : rot, NULL))
+        return FALSE;
+    xf86DrvMsg(pScrn->scrnIndex, X_INFO, "RandR rotation 0x%x (%dx%d)\n",
+               rot, w, h);
+    return TRUE;
+}
+
+static Bool
 FBDevDriverFunc(ScrnInfoPtr pScrn, xorgDriverFuncOp op, pointer ptr)
 {
     xorgHWFlags *flag;
+    FBDevPtr fPtr;
     
     switch (op) {
 	case GET_REQUIRED_HW_INTERFACES:
 	    flag = (CARD32*)ptr;
 	    (*flag) = 0;
 	    return TRUE;
+	case RR_GET_INFO:
+	    fPtr = FBDEVPTR(pScrn);
+	    if (!fPtr || !fPtr->rrRotation)
+		return FALSE;
+	    ((xorgRRRotation *)ptr)->RRRotations =
+		RR_Rotate_0 | RR_Rotate_90 | RR_Rotate_180 | RR_Rotate_270;
+	    return TRUE;
+	case RR_SET_CONFIG:
+	    fPtr = FBDEVPTR(pScrn);
+	    if (!fPtr || !fPtr->rrRotation)
+		return FALSE;
+	    return FBDevRandRSetConfig(pScrn, &((xorgRRRotation *)ptr)->RRConfig);
 	default:
 	    return FALSE;
     }
