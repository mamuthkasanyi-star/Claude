+static Bool
+FBDevCrtcPreInit(ScrnInfoPtr pScrn)
+{
+    FBDevPtr fPtr = FBDEVPTR(pScrn);
+    DisplayModePtr savedModes = pScrn->modes;
+    DisplayModePtr savedCurrent = pScrn->currentMode;
+    xf86CrtcPtr crtc;
+    xf86OutputPtr output;
+    int mn, mx;
+
+    if (!pScrn->currentMode)
+	return FALSE;
+
+    fPtr->hwMode = xf86DuplicateMode(pScrn->currentMode);
+    if (!fPtr->hwMode)
+	return FALSE;
+    fPtr->hwMode->next = fPtr->hwMode->prev = NULL;
+    fPtr->hwWidth = fPtr->hwMode->HDisplay;
+    fPtr->hwHeight = fPtr->hwMode->VDisplay;
+    mn = fPtr->hwWidth < fPtr->hwHeight ? fPtr->hwWidth : fPtr->hwHeight;
+    mx = fPtr->hwWidth > fPtr->hwHeight ? fPtr->hwWidth : fPtr->hwHeight;
+
+    xf86CrtcConfigInit(pScrn, &fbdevCrtcConfigFuncs);
+    xf86CrtcSetSizeRange(pScrn, mn, mn, mx, mx);
+
+    crtc = xf86CrtcCreate(pScrn, &fbdevCrtcFuncs);
+    if (!crtc)
+	return FALSE;
+    output = xf86OutputCreate(pScrn, &fbdevOutputFuncs, "DSI-1");
+    if (!output)
+	return FALSE;
+    output->possible_crtcs = 1;
+    output->possible_clones = 0;
+    output->interlaceAllowed = FALSE;
+    output->doubleScanAllowed = FALSE;
+    output->subpixel_order = SubPixelUnknown;
+    /* physical size unknown (as before): keeps desktop scaling unchanged */
+    output->mm_width = 0;
+    output->mm_height = 0;
+
+    /*
+     * xf86InitialConfiguration() replaces (and frees) pScrn->modes; the
+     * fbdevhw built-in mode is embedded in its private record, so detach
+     * it first.  The hardware keeps using fPtr->hwMode.
+     */
+    pScrn->modes = NULL;
+    pScrn->currentMode = NULL;
+    if (!xf86InitialConfiguration(pScrn, TRUE)) {
+	xf86DrvMsg(pScrn->scrnIndex, X_ERROR, "RandR: initial configuration failed\n");
+	pScrn->modes = savedModes;
+	pScrn->currentMode = savedCurrent;
+	return FALSE;
+    }
+    pScrn->displayWidth = pScrn->virtualX;
+
+    xf86DrvMsg(pScrn->scrnIndex, X_INFO,
+	       "RandR 1.2: output DSI-1 %dx%d, screen %dx%d..%dx%d, rotation via shadow\n",
+	       fPtr->hwWidth, fPtr->hwHeight, mn, mn, mx, mx);
+    return TRUE;
+}
