+
+static DisplayModePtr
+fbdevOutputGetModes(xf86OutputPtr output)
+{
+    FBDevPtr fPtr = FBDEVPTR(output->scrn);
+    DisplayModePtr mode;
+
+    if (!fPtr->hwMode)
+	return NULL;
+    mode = xf86DuplicateMode(fPtr->hwMode);
+    if (!mode)
+	return NULL;
+    /* fbdev drivers often report pixclock 0: claim 60 Hz for clients */
+    if (mode->Clock <= 0 && mode->HTotal > 0 && mode->VTotal > 0)
+	mode->Clock = (int) ((long) mode->HTotal * mode->VTotal * 60 / 1000);
+    mode->type = M_T_DRIVER | M_T_PREFERRED;
+    mode->status = MODE_OK;
+    mode->next = mode->prev = NULL;
+    xf86SetModeDefaultName(mode);
+    mode->VRefresh = xf86ModeVRefresh(mode);
+    return mode;
+}
