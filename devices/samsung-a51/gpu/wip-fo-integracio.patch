diff --git a/devices/samsung-a51/overlay/etc/mamuthka/grafika.conf b/devices/samsung-a51/overlay/etc/mamuthka/grafika.conf
new file mode 100644
index 0000000..62fd5bc
--- /dev/null
+++ b/devices/samsung-a51/overlay/etc/mamuthka/grafika.conf
@@ -0,0 +1,15 @@
+# Mamuthka linux (Galaxy A51) – grafika.
+# Felhasználónként felülírható: ~/.config/mamuthka/grafika.conf
+# A változás a következő bejelentkezéskor él (kijelentkezés / újraindítás).
+
+# Az asztal (Cinnamon/Muffin) rajzolása:
+#   GPU=1  a telefon GPU-ja (Mali-G72, gyári meghajtó a libhybris-en át, GLES2)
+#   GPU=0  szoftveres rajzolás (Mesa llvmpipe, a processzoron)
+# Ha a GPU-s Cinnamon összeomlik, a munkamenet végéig magától llvmpipe-ra vált.
+# Az asztalról indított programok mindkét esetben a Mesa-t használják.
+GPU=1
+
+# Az llvmpipe rajzolószálainak száma (1–8). Az Exynos 9611-ben 4 nagy (A73,
+# 2,3 GHz) és 4 kis (A53, 1,7 GHz) mag van; 4 szálnál kevesebb szál ébred
+# minden képkockánál (kisebb fogyasztás), de egy-egy nagy rajzolás lassabb.
+#LP_NUM_THREADS=4
diff --git a/devices/samsung-a51/overlay/usr/lib/mamuthka/gpu/cinnamon-gpu.env b/devices/samsung-a51/overlay/usr/lib/mamuthka/gpu/cinnamon-gpu.env
new file mode 100644
index 0000000..bb3a5b6
--- /dev/null
+++ b/devices/samsung-a51/overlay/usr/lib/mamuthka/gpu/cinnamon-gpu.env
@@ -0,0 +1,19 @@
+# Mamuthka linux (Galaxy A51) – a GPU-s Cinnamon környezete: Muffin/Cogl GLES2
+# az EGL-en át; az EGL a libhybris (x11 platform), amely a gyári Mali-G72
+# meghajtót (libGLES_mali.so) tölti be. A /usr/local/bin/cinnamon olvassa be.
+# A gpu-env-takarito.so az első kirajzolás után törli ezeket a változókat, így
+# a Cinnamonból indított programok a szokásos Mesa-t használják.
+_mg=/usr/lib/mamuthka/gpu
+_ma=$_mg/android
+export MAMUTHKA_GPU_LDPATH=1 MAMUTHKA_GPU_LDPATH_EREDETI="${LD_LIBRARY_PATH:-}"
+export LD_LIBRARY_PATH=$_mg/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
+export HYBRIS_LINKER_DIR=$_mg/lib/libhybris/linker
+export HYBRIS_ANDROID_SDK_VERSION=33
+export HYBRIS_LD_LIBRARY_PATH=$_ma/vendor/lib64:$_ma/vendor/lib64/egl:$_ma/vendor/lib64/hw:$_ma/apex/com.android.runtime/lib64/bionic:$_ma/apex/com.android.runtime/lib64:$_ma/apex/com.android.vndk.v33/lib64:$_ma/system/lib64
+export LIBEGL=libGLES_mali.so LIBGLESV2=libGLES_mali.so HYBRIS_LIBGLESV1=libGLES_mali.so
+export EGL_PLATFORM=x11 HYBRIS_EGLPLATFORM_DIR=$_mg/lib/libhybris
+export HYBRIS_LOGGING_LEVEL=warn
+export __EGL_VENDOR_LIBRARY_FILENAMES=$_mg/10_libhybris.json
+export COGL_DRIVER=gles2
+export LD_PRELOAD=$_mg/lib/gpu-env-takarito.so${LD_PRELOAD:+:$LD_PRELOAD}
+unset _mg _ma
diff --git a/devices/samsung-a51/overlay/usr/local/bin/cinnamon b/devices/samsung-a51/overlay/usr/local/bin/cinnamon
new file mode 100755
index 0000000..25e9701
--- /dev/null
+++ b/devices/samsung-a51/overlay/usr/local/bin/cinnamon
@@ -0,0 +1,44 @@
+#!/bin/sh
+# Mamuthka linux – Cinnamon indító: GPU-val (Mali-G72, libhybris, GLES2) vagy
+# szoftveres rajzolással (Mesa llvmpipe).
+#
+# Kapcsoló: /etc/mamuthka/grafika.conf, felhasználónként
+# ~/.config/mamuthka/grafika.conf:  GPU=1 (Mali) | GPU=0 (llvmpipe)
+# Önvédelem: ha a GPU-s Cinnamon összeomlik (a cinnamon-launcher ilyenkor
+# MAMUTHKA_GPU_TILTVA=1-gyel indítja újra), vagy 90 másodpercen belül újra
+# indul, a munkamenet hátralevő részében llvmpipe-pal fut.
+# A /usr/local/bin a PATH-ban a /usr/bin előtt van: a cinnamon-launcher és a
+# global.reexec_self() is ezt indítja.
+# A GPU-s környezeti változókat a gpu-env-takarito.so az első kirajzolás után
+# törli, így a Cinnamonból indított programok a megszokott Mesa-t használják.
+VALODI=/usr/bin/cinnamon
+gpu=1
+for f in /etc/mamuthka/grafika.conf "$HOME/.config/mamuthka/grafika.conf"; do
+	[ -r "$f" ] || continue
+	v=$(sed -n 's/^[[:space:]]*GPU=\([01]\)[[:space:]]*$/\1/p' "$f" | tail -n 1)
+	[ -n "$v" ] && gpu=$v
+done
+[ "${MAMUTHKA_GPU_TILTVA:-0}" = 1 ] && gpu=0
+
+envf=/usr/lib/mamuthka/gpu/cinnamon-gpu.env
+[ -r "$envf" ] && [ -c /dev/mali0 ] || gpu=0
+
+jel="${XDG_RUNTIME_DIR:-/tmp}/mamuthka-gpu.inditas"
+if [ "$gpu" = 1 ] && [ -f "$jel" ]; then
+	most=$(date +%s); volt=$(cat "$jel" 2>/dev/null || echo 0)
+	if [ $((most - volt)) -lt 90 ]; then
+		echo "mamuthka-gpu: a GPU-s Cinnamon nemrég újraindult – llvmpipe a munkamenet végéig" >&2
+		gpu=0
+		export MAMUTHKA_GPU_TILTVA=1
+	fi
+fi
+
+if [ "$gpu" = 1 ]; then
+	date +%s > "$jel"
+	echo "mamuthka-gpu: Cinnamon GPU-val (libhybris, $envf)" >&2
+	# shellcheck disable=SC1090
+	. "$envf"
+else
+	echo "mamuthka-gpu: Cinnamon llvmpipe-pal" >&2
+fi
+exec "$VALODI" "$@"
