[Unit]
Description=Mamuthka linux: gyökér-fájlrendszer kiterjesztése a teljes partícióra
ConditionPathExists=!/var/lib/mamuthka/rootfs-resized
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/mamuthka/resize-rootfs
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
