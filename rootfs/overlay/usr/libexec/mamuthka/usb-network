#!/bin/bash
# Az initramfs már beállította a USB-gadgetet (g_ether, NCM vagy RNDIS) és az IP-t.
# Itt csak megkeressük az interfészt, és DHCP-t indítunk a gép felé.
set -u
# Az interfészt a /sys/class/net alapján keressük (az a hálózati eszköz, amelynek
# a device-a a USB-gadget; ez a beépített g_ether usb0-ja vagy a configfs
# ncm/rndis). A configfs "ifname" attribútumát NEM olvassuk: bindolatlan ncm-nél
# ez kernel-Oopsot okozott (gether_get_ifname NULL net, hibak.txt 54.).
iface=""
for d in /sys/class/net/*; do
	[ -e "$d" ] || continue
	case "$(readlink -f "$d/device" 2>/dev/null)" in
		*/gadget) iface="${d##*/}"; break ;;
	esac
done
if [ -z "$iface" ]; then
	for i in usb0 rndis0 ncm0; do
		[ -e "/sys/class/net/$i" ] && { iface="$i"; break; }
	done
fi
if [ -z "$iface" ]; then
	echo "Nincs USB-hálózati interfész (a gadget nem jött létre)."
	exit 1
fi
ip link set "$iface" up
ip addr show dev "$iface" | grep -q "inet $USB_NET_IP/" || ip addr add "$USB_NET_IP/24" dev "$iface"
echo "USB-hálózat: $iface, $USB_NET_IP"
exec dnsmasq --keep-in-foreground --no-resolv --no-hosts --port=0 \
	--interface="$iface" --bind-interfaces --leasefile-ro \
	--dhcp-range="$USB_NET_CLIENT_IP,$USB_NET_CLIENT_IP,255.255.255.0,1h" \
	--dhcp-option=3 --dhcp-option=6
