#!/bin/sh
# A Mamuthka böngésző (Firefox-réteg) felhasználói beállítása. Idempotens:
# a konfigfájlok ellenőrzőösszege a jelzőfájlban; csak változáskor (vagy
# --force-ra) fut újra. Hívja: az autostart (első bejelentkezés) és a
# /usr/local/bin/mamuthka indító, ha még nincs felhasználói indító.
set -eu
ASSETS=/usr/share/mamuthka/bongeszo
STAMP="${XDG_CONFIG_HOME:-$HOME/.config}/mamuthka/bongeszo.stamp"
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/mamuthka/bongeszo-setup.log"
[ "$(id -u)" -ne 0 ] || { echo "ne rootként futtasd" >&2; exit 1; }
[ -d "$ASSETS" ] || exit 0
mkdir -p "$(dirname "$STAMP")" "$(dirname "$LOG")"
sum=$(cd "$ASSETS" && find . -type f ! -name README.md | LC_ALL=C sort | xargs cat | sha256sum | cut -d' ' -f1)
if [ "${1:-}" != "--force" ] && [ -f "$STAMP" ] && [ "$(cat "$STAMP")" = "$sum" ] &&
	[ -x "$HOME/.local/bin/mamuthka" ]; then
	exit 0
fi
# Egyszerre csak egy példány (autostart + indító versenyhelyzet).
exec 9>"$(dirname "$STAMP")/.bongeszo.lock"
flock 9
[ "${1:-}" != "--force" ] && [ -f "$STAMP" ] && [ "$(cat "$STAMP")" = "$sum" ] &&
	[ -x "$HOME/.local/bin/mamuthka" ] && exit 0
# Futó Firefox mellett a -CreateProfile is lefut, de a profilt ne írjuk egy
# éppen használt Mamuthka-példány alá.
if pgrep -u "$(id -u)" -f -- '-P Mamuthka' >/dev/null 2>&1; then
	echo "$(date '+%F %T') a Mamuthka fut, a beállítás a következő bejelentkezéskor" >> "$LOG"
	exit 0
fi
if MAMUTHKA_NINCS_POLICY=1 MAMUTHKA_ALAP=1 nice -n 10 "$ASSETS/telepito-ubuntu.sh" >> "$LOG" 2>&1; then
	echo "$sum" > "$STAMP"
else
	echo "$(date '+%F %T') HIBA, lásd fent" >> "$LOG"
	exit 1
fi
