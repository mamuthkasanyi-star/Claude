# Fekete háttér, középen a pingvines logó, alatta lüktető pontok.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo.image = Image("logo.png");
scale = Math.Min(Window.GetWidth() * 0.6 / logo.image.GetWidth(), 1);
logo.image = logo.image.Scale(logo.image.GetWidth() * scale, logo.image.GetHeight() * scale);
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);

dot = Image("dot.png");
for (i = 0; i < 3; i++) {
	dots[i] = Sprite(dot);
	dots[i].SetX(Window.GetWidth() / 2 + (i - 1) * dot.GetWidth() * 2 - dot.GetWidth() / 2);
	dots[i].SetY(Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + dot.GetHeight() * 2);
}

t = 0;
fun refresh() {
	t++;
	for (i = 0; i < 3; i++) {
		if (i == Math.Int(t / 10) % 3) dots[i].SetOpacity(1);
		else dots[i].SetOpacity(0.25);
	}
}
Plymouth.SetRefreshFunction(refresh);

# Jelszókérés / üzenetek (pl. fájlrendszer-ellenőrzés) szöveges megjelenítése
message_sprite = Sprite();
fun message_cb(text) {
	message_sprite.SetImage(Image.Text(text, 0.8, 0.8, 0.8));
	message_sprite.SetX(Window.GetWidth() / 2 - message_sprite.GetImage().GetWidth() / 2);
	message_sprite.SetY(Window.GetHeight() * 0.85);
}
Plymouth.SetMessageFunction(message_cb);
