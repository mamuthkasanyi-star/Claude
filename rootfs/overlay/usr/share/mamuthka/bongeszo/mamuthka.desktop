[Desktop Entry]
Version=1.0
Type=Application
Name=Mamuthka
GenericName=Webböngésző
Comment=Mamuthka asztali böngésző (Firefox alapon, fekete-piros téma)
Exec=mamuthka %u
Icon=mamuthka
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=Mamuthka
Actions=new-window;private-window;

[Desktop Action new-window]
Name=Új ablak
Exec=mamuthka --new-window %u

[Desktop Action private-window]
Name=Privát ablak
Exec=mamuthka --private-window %u
