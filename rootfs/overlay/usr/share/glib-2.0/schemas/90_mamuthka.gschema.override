# Mamuthka linux alapértelmezések (a @...@ értékeket a setup.sh tölti ki)

[org.cinnamon.desktop.interface]
scaling-factor=uint32 @UI_SCALE@
gtk-theme='@GTK_THEME@'
icon-theme='@ICON_THEME@'
cursor-size=24
# Nincs GPU-gyorsítás (a Mali csak a gyári Android-blobbal menne, DRM nincs):
# a kompozitor llvmpipe-pal, CPU-n rajzol, ezért animációk nélkül fut.
enable-animations=false
# Panelóra: 24 órás, másodpercekkel (a user kérése; másodpercenként egy kis
# panel-újrarajzolás). A képernyővédő órája lent saját formátumot kap.
clock-show-seconds=true
clock-use-24h=true

[org.gnome.desktop.interface]
gtk-theme='@GTK_THEME@'
icon-theme='@ICON_THEME@'
color-scheme='prefer-dark'

[org.cinnamon.desktop.wm.preferences]
theme='@GTK_THEME@'

[org.cinnamon]
desktop-effects=false
desktop-effects-workspace=false
desktop-effects-on-dialogs=false
desktop-effects-on-menus=false
startup-animation=false
# Kedvencek / menü: a Firefox helyett a Mamuthka böngésző (ugyanaz a Firefox,
# a Mamuthka-profillal; /usr/share/applications/mamuthka.desktop).
favorite-apps=['mamuthka.desktop', 'cinnamon-settings.desktop', 'org.gnome.Terminal.desktop', 'nemo.desktop']
# Kevesebb applet (llvmpipe: minden applet a panel újrarajzolását növeli):
# nincs nyomtató-applet (nincs CUPS) és nincs külön kedvencek-applet (a menüben
# és a panel ablaklistáján ugyanazok vannak).
enabled-applets=['panel1:left:0:menu@cinnamon.org:0', 'panel1:left:1:separator@cinnamon.org:1', 'panel1:left:2:grouped-window-list@cinnamon.org:2', 'panel1:right:0:systray@cinnamon.org:3', 'panel1:right:1:xapp-status@cinnamon.org:4', 'panel1:right:2:notifications@cinnamon.org:5', 'panel1:right:3:removable-drives@cinnamon.org:7', 'panel1:right:4:keyboard@cinnamon.org:8', 'panel1:right:5:network@cinnamon.org:10', 'panel1:right:6:sound@cinnamon.org:11', 'panel1:right:7:power@cinnamon.org:12', 'panel1:right:8:calendar@cinnamon.org:13', 'panel1:right:9:cornerbar@cinnamon.org:14']

[org.cinnamon.muffin]
# Teljes képernyős ablak (videó, játék) kompozitálás nélkül rajzolhat.
unredirect-fullscreen-windows=true

[org.cinnamon.theme]
name='cinnamon'

[org.cinnamon.desktop.background]
picture-uri='file:///usr/share/backgrounds/mamuthka/wallpaper.png'
picture-options='zoom'
primary-color='#000000'

# Kiegyensúlyozott energiagazdálkodás: 1 perc után kikapcsol a kijelző.
[org.cinnamon.desktop.session]
idle-delay=uint32 60

[org.cinnamon.settings-daemon.plugins.power]
sleep-display-ac=60
sleep-display-battery=60
sleep-inactive-ac-timeout=0
sleep-inactive-battery-timeout=0
button-power='blank'
lock-on-suspend=true

[org.cinnamon.desktop.lockdown]
disable-lock-screen=true

# Képernyőzár kikapcsolva (a user kérése, 2026-10-17).
[org.cinnamon.desktop.screensaver]
lock-enabled=false
lock-delay=uint32 0
# A lebegő óra/album-widget a zárolt képernyőn folyamatosan mozog és rajzol
# (llvmpipe, kikapcsolt kijelzőnél is) – fogyasztás miatt kikapcsolva.
floating-widgets=false
# A képernyővédő órája alapból a clock-show-seconds-ot követi (WallClock):
# másodpercenként újrarajzolja a teljes képernyős ablakot, ami llvmpipe-pal
# ~0,8 CPU-másodperc/másodperc – kikapcsolt kijelzőnél is (mérve a 76e2d56-on:
# cinnamon 108% CPU, 8 llvmpipe-szál, pontosan másodperces löketek; hibak.txt).
# Saját formátum másodpercek nélkül → percenként egy rajzolás.
use-custom-format=true
time-format='%H:%M'
date-format='%A %B %e'

# Érintőképernyős billentyűzet (Onboard): szövegmezőnél automatikusan feljön.
[org.cinnamon.desktop.a11y.applications]
screen-keyboard-enabled=false

[org.onboard]
layout='Phone'
theme='Nightshade'
start-minimized=true
show-status-icon=true

[org.onboard.auto-show]
enabled=true

[org.onboard.window]
docking-enabled=true
force-to-top=true
